# VLESS UUID (必需)
# 格式：xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
UUID=

# 服务器端口 (必需)
# 范围：1-65535
PORT=3000

# 服务器域名 (必需)
# 例如：example.com
TUNNEL_DOMAIN=

# Cloudflare Tunnel 配置
TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# 强制使用 IPv6 连接 Cloudflare 边缘节点 (可选)
# 设为 6 时启用，留空则自动选择
TUNNEL_FORCE_IP_VERSION=

# cloudflared 传输协议 (可选)
# 例如：quic、http2，留空则由 cloudflared 自动选择
TUNNEL_TRANSPORT_PROTOCOL=

# 服务器名称 (可选)
# 默认为主机名
NAME=

# 最大内存用量（字节，可选）
# 默认 512MB = 536870912
MAX_MEMORY_USAGE=